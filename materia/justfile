name := "materia"

import '../sysext.just'

all: default

# Custom download step to get materia
# TODO: Automate version bumps
download-manual arch=arch:
    #!/bin/bash
    set -euo pipefail
    {{retry_function}}
    if [[ -n "{{debug}}" ]]; then
      set -x
    fi

    mkdir binaries
    cd binaries

    arch="{{arch}}"
    version="0.8.0"
    if [[ "${arch}" == "x86_64" ]]; then
        goarch="amd64"
        sha256sum="5ac4a44a54bbdc71f87db4d168c0246f6b272208d6a0a28e66575ab649bcf09d"
    else
        goarch="arm64"
        sha256sum="a96d36b157262d3924cd4a2f66cfa43d96117f1f3d8667b7610fea526d8be5d9"
    fi

    echo "⬇️ Downloading materia"
    destfile="materia-v${version}-${goarch}.tar.gz"
    retry 3 5 curl --fail --location --remote-name \
        "https://github.com/stryan/materia/releases/download/v${version}/${destfile}"
    echo "${sha256sum}  ${destfile}" | sha256sum --check

    tar xvf ${destfile}
    rm ${destfile} README.md

    # Version & metadata
    echo "${version}" > ../version
    echo "${sha256sum}  ${destfile}" >> ../inputs

# Skip default recipe
version:
    true

# Custom installation step to install materia
install-manual:
    #!/bin/bash
    set -euo pipefail
    if [[ -n "{{debug}}" ]]; then
      set -x
    fi

    if [[ "${UID}" == "0" ]]; then
        SUDO=""
    else
        SUDO="sudo"
    fi

    cd rootfs

    echo "➡️ Installing materia"
    ${SUDO} install -D -m 755 ../binaries/bin/materia -T usr/bin/materia
    ${SUDO} install -D -m 644 ../binaries/LICENSE -t usr/share/licenses/materia/LICENSE
    ${SUDO} install -D -m 644 ../binaries/man/man1/materia.1 -t usr/share/man/man1
    ${SUDO} install -D -m 644 ../binaries/man/man5/*.5 -t usr/share/man/man5
    ${SUDO} install -D -m 644 ../binaries/systems.primamateria.materia.conf -t usr/share/dbus-1/system.d
    ${SUDO} chown -R root: usr
